rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getPairData(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }

    function isPairMember(pairId) {
      let pair = getPairData(pairId);
      return isAuthenticated()
        && (request.auth.uid == pair.user1Id || request.auth.uid == pair.user2Id);
    }

    function getTaskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function isTaskPairMember(taskId) {
      let task = getTaskData(taskId);
      return isPairMember(task.pairId);
    }

    function getOccurrenceData(occurrenceId) {
      return get(/databases/$(database)/documents/taskOccurrences/$(occurrenceId)).data;
    }

    function getExecutionData(executionId) {
      return get(/databases/$(database)/documents/taskExecutions/$(executionId)).data;
    }

    // ============================================
    // Users Collection
    // Fields: email, displayName, photoUrl, createdAt, pairId
    // Doc ID = Firebase Auth UID
    // ============================================
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for pair invites, displaying partner info)
      allow read: if isAuthenticated();
      // Only the user themselves can write their own document
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ============================================
    // Pairs Collection
    // Fields: user1Id, user2Id, createdAt, name, scoreTarget
    // ============================================
    match /pairs/{pairId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.user1Id
            || request.auth.uid == resource.data.user2Id);

      allow create: if isAuthenticated()
        && (request.auth.uid == request.resource.data.user1Id
            || request.auth.uid == request.resource.data.user2Id);

      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.user1Id
            || request.auth.uid == resource.data.user2Id);

      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.user1Id
            || request.auth.uid == resource.data.user2Id);
    }

    // ============================================
    // Pair Invites Collection
    // Fields: fromUserId, toEmail, pairId, status, createdAt
    // ============================================
    match /pairInvites/{inviteId} {
      // Readable by the sender or the recipient (matched by email from auth token)
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.token.email == resource.data.toEmail);

      // Only the inviting user can create an invite
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId;

      // Both sender and recipient can update (accept/decline/cancel)
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.token.email == resource.data.toEmail);

      // Only the sender can delete
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.fromUserId;
    }

    // ============================================
    // Tasks Collection
    // Fields: pairId, title, description, assignedTo, points, isActive,
    //         recurrenceId, createdAt, createdBy
    // ============================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow create: if isAuthenticated() && isPairMember(request.resource.data.pairId);
      allow update: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow delete: if isAuthenticated() && isPairMember(resource.data.pairId);
    }

    // ============================================
    // Task Recurrences Collection
    // Fields: taskId, type, daysOfWeek, dayOfMonth, startDate, endDate, isActive
    // ============================================
    match /taskRecurrences/{recurrenceId} {
      allow read: if isAuthenticated() && isTaskPairMember(resource.data.taskId);
      allow create: if isAuthenticated() && isTaskPairMember(request.resource.data.taskId);
      allow update: if isAuthenticated() && isTaskPairMember(resource.data.taskId);
      allow delete: if isAuthenticated() && isTaskPairMember(resource.data.taskId);
    }

    // ============================================
    // Task Occurrences Collection
    // Fields: taskId, pairId, dueDate, status, assignedTo
    // ============================================
    match /taskOccurrences/{occurrenceId} {
      allow read: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow create: if isAuthenticated() && isPairMember(request.resource.data.pairId);
      allow update: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow delete: if isAuthenticated() && isPairMember(resource.data.pairId);
    }

    // ============================================
    // Task Executions Collection
    // Fields: occurrenceId, taskId, executedBy, executedAt, notes, photoUrl
    // ============================================
    match /taskExecutions/{executionId} {
      // Readable by pair members (verified via task → pair lookup)
      allow read: if isAuthenticated() && isTaskPairMember(resource.data.taskId);

      // Only the assigned executor can create, and must be a pair member
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.executedBy
        && isTaskPairMember(request.resource.data.taskId);

      // Only the original executor can update their execution
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.executedBy
        && isTaskPairMember(resource.data.taskId);

      allow delete: if false;
    }

    // ============================================
    // Task Validations Collection
    // Fields: executionId, occurrenceId, validatedBy, validatedAt, isApproved, feedback
    // ============================================
    match /taskValidations/{validationId} {
      // Readable by pair members (verified via occurrence → pair lookup)
      allow read: if isAuthenticated()
        && isPairMember(getOccurrenceData(resource.data.occurrenceId).pairId);

      // Writable only by the validating pair member who is NOT the executor
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.validatedBy
        && request.auth.uid != getExecutionData(request.resource.data.executionId).executedBy
        && isPairMember(getOccurrenceData(request.resource.data.occurrenceId).pairId);

      // Only the original validator can update
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.validatedBy
        && isPairMember(getOccurrenceData(resource.data.occurrenceId).pairId);

      allow delete: if false;
    }

    // ============================================
    // Scores Collection
    // Fields: pairId, userId, totalPoints, periodPoints, updatedAt
    // ============================================
    match /scores/{scoreId} {
      allow read: if isAuthenticated() && isPairMember(resource.data.pairId);
      // Pair members can create/update scores (score calculation runs client-side)
      allow create: if isAuthenticated() && isPairMember(request.resource.data.pairId);
      allow update: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow delete: if false;
    }

    // ============================================
    // Rewards Collection
    // Fields: pairId, title, description, requiredPoints, isUnlocked, unlockedAt
    // ============================================
    match /rewards/{rewardId} {
      allow read: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow create: if isAuthenticated() && isPairMember(request.resource.data.pairId);
      allow update: if isAuthenticated() && isPairMember(resource.data.pairId);
      allow delete: if isAuthenticated() && isPairMember(resource.data.pairId);
    }
  }
}
